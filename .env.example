# Publicité vidéo récompensée AppLixir (déblocage des fiches, lib/deblocage.ts) :
# clé publique du dashboard AppLixir (client.applixir.com). Vide = déblocage
# désactivé (le contenu réservé est alors servi librement aux comptes connectés).
NEXT_PUBLIC_APPLIXIR_API_KEY=
MAIL_FROM="DataParl'" <noreply@dataparl.fr>
PRIVACY_VERSION=2026-10

# Secrets (Vercel uniquement, jamais dans le code)
AUTH_SUPABASE_SERVICE_ROLE_KEY=
DATA_SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
CONSENT_SALT=
ADMIN_VAULT_KEY=
ADMIN_OTP_SECRET=
RESEND_WEBHOOK_SECRET=
ADMIN_GITHUB_LOGINS=dataparl
# Secret de rappel AppLixir (« callback secret » du dashboard, à définir aussi
# là-bas) : exigé pour valider le webhook /api/webhooks/applixir (lib/pub.ts).
# Sans ce secret ET la clé publique, pubActive() est fausse → pas de déblocage.
APPLIXIR_SECRET=
# Relais de secours (lib/mail.ts — facultatif, vide = relais désactivé) :
# si Resend refuse l'envoi, on retente via Postmark puis Mailgun
POSTMARK_SERVER_TOKEN=           # Postmark (domaine vérifié dataparl.com)
MAILGUN_API_KEY=                # Mailgun (domaine vérifié dataparl.info, région UE)
# Heartbeat Better Stack (monitor « Cron alertes ») : URL pingée par le cron
# /api/cron/alertes à chaque exécution (contient un jeton — ne jamais committer)
BETTERSTACK_HEARTBEAT_URL=
# Console Slack (app Slack « DataParl' Maintenance »)
MAINTENANCE_TOKEN=              # authentifie les commandes Slack /maintenance et /stats
SLACK_WEBHOOK_URL=              # incoming webhook de l'app Slack → #monitoring (digest + publications riches)
SLACK_MONITORING=               # adresse e-mail du canal #monitoring (repli du digest, texte seul)
X_HANDLE=                      # compte X/Twitter (facultatif — abonnés affichés dans /stats)
BUFFER_API_KEY=                 # Buffer (stats followers + commande /post : publish.buffer.com/settings/api)
SLACK_BOT_TOKEN=                # Bot User OAuth Token (xoxb-…) de l'app Slack — modal /post

# Sentry (optionnel — si vide, le suivi d'erreurs est désactivé)
NEXT_PUBLIC_SENTRY_DSN=
